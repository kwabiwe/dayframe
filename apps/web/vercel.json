{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/location-retention",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/cron/live-activity-retry",
      "schedule": "47 3 * * *"
    }
  ],
  "functions": {
    "src/app/api/location/evidence/route.ts": {
      "supportsCancellation": true
    },
    "src/app/api/location/replay/route.ts": {
      "supportsCancellation": true
    }
  }
}
