DATABASE_URL=postgres://dayframe:dayframe@localhost:54322/dayframe
NEXT_PUBLIC_DAYFRAME_API_BASE=http://localhost:3000
# NEXT_PUBLIC_DAYFRAME_MAP_STYLE_URL=https://maps.example.com/styles/dayframe/style.json
DAYFRAME_AUTH_MODE=dev
DAYFRAME_DEV_USER_ID=00000000-0000-4000-8000-000000000001
DAYFRAME_DEV_WORKSPACE_ID=00000000-0000-4000-8000-000000000010
# Hosted provider auth. Preview values must use the staging Supabase project;
# production values must use production. The anon key is a legacy fallback.
# NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# DAYFRAME_ALLOWED_SIGNUP_EMAILS=you@example.com,friend@example.com
# DAYFRAME_SIGNUPS_ENABLED=false
# Optional absolute app-session TTL: 60 seconds to 365 days; default 30 days.
# DAYFRAME_SESSION_TTL_SECONDS=2592000
# Preview only. Leave absent in production.
# NEXT_PUBLIC_DAYFRAME_DEPLOYMENT_ENV=staging
DAYFRAME_INGEST_TOKEN=
# Server-only Geoapify credential for authenticated place search.
GEOAPIFY_API_KEY=
# Server-authoritative Location Intelligence mode. Keep shadow until hosted
# migration, RLS, TestFlight and physical-device validation are complete.
DAYFRAME_LOCATION_ROLLOUT_MODE=v2_shadow
# Required by Vercel Cron before the retention schedule can run.
CRON_SECRET=
# ActivityKit remote update credentials from the Apple Developer portal.
# Store the .p8 contents as one line with escaped newlines in hosted environments.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.layereight.dayframe
