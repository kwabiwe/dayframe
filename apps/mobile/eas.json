{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_DAYFRAME_API_BASE": "http://localhost:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_DAYFRAME_API_BASE": "https://dayframe-staging.vercel.app",
        "EXPO_PUBLIC_DAYFRAME_RELEASE_CHANNEL": "preview"
      }
    },
    "production": {
      "distribution": "store",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_DAYFRAME_API_BASE": "https://dayframe-web.vercel.app",
        "EXPO_PUBLIC_DAYFRAME_RELEASE_CHANNEL": "production"
      }
    }
  }
}
